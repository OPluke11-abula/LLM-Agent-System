  "findings": [
    {
      "id": "SEC-73-01",
      "severity": "Medium",
      "category": "Insecure Default Fallback Credentials",
      "target": "agent_workspace/routes/collaboration.py:L720-723",
      "description": "Slack and LINE webhook signature validation fall back to static mock strings (mock_slack_secret_12345, mock_line_secret_12345) when environment variables are unset.",
      "impact": "If deployed in production without setting secrets, an attacker knowing the default string could forge incoming webhooks and trigger agent conversations.",
      "remediation": "Fail-closed: if the signing secret environment variable is missing, raise a 503 Service Unavailable or reject incoming requests rather than falling back to mock strings in non-test mode.",
      "status": "Documented for Owner Decision"
    },
    {
      "id": "SEC-73-02",
      "severity": "Medium",
      "category": "Network Exposure of Unauthenticated Service",
      "target": "docker-compose.microservices.yml:L7-8",
      "description": "Redis service publishes port 6379:6379 to all host network interfaces (0.0.0.0) without password authentication.",
      "impact": "Any network peer with access to the host IP on port 6379 can read/write swarm pubsub messages and cache data without authentication.",
      "remediation": "Bind Redis port explicitly to localhost (127.0.0.1:6379:6379) or remove host port publishing entirely since swarm worker containers reach Redis via the internal Docker network name redis:6379.",
      "status": "Documented for Owner Decision"
    },
    {
      "id": "SEC-73-03",
      "severity": "Low",
      "category": "Container Least Privilege Violation",
      "target": "docker-compose.yml & docker-compose.microservices.yml",
      "description": "All container services run under default root user inside the container.",
      "impact": "Container breakout vulnerabilities would grant immediate root access to volume mounts and potential kernel surfaces.",
      "remediation": "Add non-root user directives (e.g. user: 1000:1000) in Dockerfiles and compose definitions.",
      "status": "Documented for Owner Decision"
    },
    {
      "id": "SEC-73-04",
      "severity": "Low",
      "category": "Missing Security Headers & Information Disclosure",
      "target": "nginx.conf:L1-22",
      "description": "Nginx configuration lacks standard HTTP security headers (X-Content-Type-Options, X-Frame-Options, CSP) and omits server_tokens off.",
      "impact": "Server discloses Nginx version banner in response headers and does not protect frontend viewer from clickjacking/MIME-sniffing.",
      "remediation": "Add server_tokens off; and security headers (X-Frame-Options: SAMEORIGIN, X-Content-Type-Options: nosniff, Referrer-Policy: strict-origin-when-cross-origin) to nginx.conf.",
      "status": "Documented for Owner Decision"
    },
    {
      "id": "SEC-73-05",
      "severity": "Info",
      "category": "Spec Schema Consumer Alignment Gap",
      "target": "spec/workflow.schema.json & spec/knowledge.schema.json",
      "description": "Two PAP specification schemas (workflow.schema.json and knowledge.schema.json) are present in spec/ but have no active runtime validators or consumers in agent_workspace/.",
      "impact": "No security risk; schemas serve as passive PAP specifications but have an alignment gap with active validators.",
      "remediation": "Integrate workflow.schema.json into workflow_lint.py or document as passive reference contracts.",
      "status": "Documented for Owner Decision"
    }
  ],
