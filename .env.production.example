# ==============================================================================
# LLM-Agent-System (LAS) Production Environment Configuration Example
# Version: v0.6.0
# Protocol: Universal Coding Agent Development Protocol v3.8.0
# ==============================================================================

# Server Network Binding
LAS_BIND_HOST=0.0.0.0
PORT=8000

# Security & Authentication (Generate using: openssl rand -hex 32)
LAS_JWT_SECRET=replace_with_strong_random_jwt_secret_hex_32

# Model Provider Credentials (Configure at least one for reasoning)
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local Ollama Inference (Optional fallback)
OLLAMA_BASE_URL=http://localhost:11434

# Swarm & Microservices Configuration
LAS_ENABLE_REDIS_SWARM=false
REDIS_URL=redis://localhost:6379

# Multi-Tenant & Audit Consensus Hardening
LAS_ENABLE_MULTI_WORKER=false
LAS_ENABLE_AUDIT_CONSENSUS=false
LAS_ENABLE_STRIPE=false

# Storage & Logging Paths
LAS_DATA_DIR=/app/.agent
LAS_MEMORY_DIR=/app/agent_workspace/memory
LAS_WORKSPACE_DIR=/app/workspace
