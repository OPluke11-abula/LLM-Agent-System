{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ai-agent-topology-viewer",
  "version": "0.6.0",
  "identifier": "com.opluke11.abula.ai-agent-topology-viewer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI Agent Topology Viewer",
        "width": 1400,
        "height": 900
      },
      {
        "label": "ceo-window",
        "title": "CEO Strategy Dashboard",
        "width": 1000,
        "height": 700,
        "visible": false
      },
      {
        "label": "dev-window",
        "title": "Developer Terminal Dashboard",
        "width": 1000,
        "height": 700,
        "visible": false
      },
      {
        "label": "auditor-window",
        "title": "Auditor Billing Dashboard",
        "width": 1000,
        "height": 700,
        "visible": false
      },
      {
        "label": "companion-window",
        "title": "LAS Ambient Companion",
        "width": 400,
        "height": 240,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "AI Agent Topology Viewer and Control Plane",
    "longDescription": "Enterprise-grade desktop control plane for LLM-Agent-System multi-agent swarms and coding pipelines",
    "copyright": "Copyright (c) 2026 Luke / OPluke11-abula",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.13",
      "dmg": {
        "windowSize": {
          "width": 600,
          "height": 400
        }
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37",
          "libxdo3"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
